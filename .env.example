# E-Scooter Rental — Environment Variables
# Copy this file to .env and adjust for your environment.
# .env is git-ignored; never commit secrets.

# Server
PORT=3000
DB_PATH=data/escooter.db

# Email (SMTP via Node built-in net — no external dependencies)
# If SMTP_HOST is unset, email notifications are silently disabled
# and a warning is logged at startup. For local dev, point at Mailpit
# (https://github.com/axllent/mailpit) or Ethereal.
# See src/backend/email-service.js for implementation.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@escooter.local
