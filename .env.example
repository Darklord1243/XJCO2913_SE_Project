# E-Scooter Rental — Environment Variables
# Copy this file to .env and adjust for your environment.
# .env is git-ignored; never commit secrets.

# Server
PORT=3000
DB_PATH=data/escooter.db

# Email (nodemailer via SMTP)
#
# Option A — Production-style (QQ Mail defaults when host omitted):
#   Set SMTP_USER + SMTP_PASS (required). Optional SMTP_HOST, SMTP_PORT, SMTP_SECURE.
#
# Option B — Local dev (Mailpit catch-all, no auth):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_FROM=noreply@escooter.local
#
# If neither credentials nor SMTP_HOST is set, email is skipped (booking still succeeds).

SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@escooter.local
# SMTP_SECURE=true
